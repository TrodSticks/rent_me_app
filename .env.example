# Copy to .env.local and fill in once the Supabase project exists.
# Until then the app runs on the rules-based search only.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Only for `npm run eval:search` on your computer (never in the app).
# Any OpenAI-compatible endpoint serving an open-source model, e.g.
#   Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
