# Copy this file to .env and fill it in. .env is ignored by git; never commit real values.

# "development" on your own computer, "production" (the default) on a live server.
# Development turns on the local mailbox at /dev/mailbox and allows http login cookies.
APP_ENV=development

# Signs login cookies and emailed links. Required on a live server: use a long random value.
# SECRET_KEY=

# Database. Defaults to the local app.db SQLite file.
# DATABASE_URL=

# Email. Leave these out in development to use the local mailbox instead of sending.
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_USE_TLS=1
# MAIL_USE_SSL=0
# MAIL_FROM=Rent Me <no-reply@yourdomain.example>

# The site's public address, used in emailed links. Example: https://rentme.example
# PUBLIC_BASE_URL=

# How many reverse proxies sit in front of the app (0 if none).
# TRUSTED_PROXY_COUNT=0
